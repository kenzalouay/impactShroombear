{%- liquid
  assign s = section.settings
  assign f = s.font
-%}

<style>
  {{ f | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .tl-wrap{
    {% if s.bg_transparent %}background:transparent;{% else %}background:{{ s.bg }};{% endif %}
    padding:{{ s.padding_top }}px 16px {{ s.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .tl-list{
    list-style:none;margin:0 auto;padding:0;
    max-width:{{ s.max_width }}px;
    display:flex;flex-direction:column;gap:{{ s.gap }}px;
    {% if s.align == 'center' %}align-items:center;{% endif %}
  }
  #shopify-section-{{ section.id }} .tl-row{
    display:flex;align-items:center;gap:{{ s.icon_gap }}px;
  }
  #shopify-section-{{ section.id }} .tl-ico{
    flex:none;width:{{ s.icon_size }}px;height:{{ s.icon_size }}px;
    border-radius:{{ s.icon_radius }}%;
    {% unless s.icon_bg_transparent %}background:{{ s.icon_bg }};{% endunless %}
    display:flex;align-items:center;justify-content:center;overflow:hidden;
  }
  #shopify-section-{{ section.id }} .tl-ico img{
    width:{{ s.icon_inner }}%;height:{{ s.icon_inner }}%;object-fit:contain;display:block;
  }
  #shopify-section-{{ section.id }} .tl-txt{
    font-family:{{ f.family }}, {{ f.fallback_families }};
    font-weight:{{ s.font_weight }};
    font-size:{{ s.font_size }}px;
    line-height:{{ s.line_height }};
    color:{{ s.text_color }};
  }
  #shopify-section-{{ section.id }} .tl-title{
    font-family:{{ f.family }}, {{ f.fallback_families }};
    text-align:{{ s.align }};max-width:{{ s.max_width }}px;margin:0 auto 18px;
    font-size:{{ s.title_size }}px;font-weight:700;color:{{ s.text_color }};line-height:1.3;
  }

  @media (max-width:600px){
    #shopify-section-{{ section.id }} .tl-wrap{
      padding:{{ s.padding_top_mobile }}px 14px {{ s.padding_bottom_mobile }}px;
    }
    #shopify-section-{{ section.id }} .tl-txt{font-size:{{ s.font_size_mobile }}px}
    #shopify-section-{{ section.id }} .tl-ico{
      width:{{ s.icon_size_mobile }}px;height:{{ s.icon_size_mobile }}px;
    }
  }
</style>

<div class="tl-wrap">
  {%- if s.title != blank -%}
    <p class="tl-title">{{ s.title }}</p>
  {%- endif -%}

  <ul class="tl-list">
    {%- for block in section.blocks -%}
      <li class="tl-row" {{ block.shopify_attributes }}>
        <span class="tl-ico">
          {%- if block.settings.icon_url != blank -%}
            <img src="{{ block.settings.icon_url }}" alt="" loading="lazy">
          {%- elsif block.settings.icon != blank -%}
            <img src="{{ block.settings.icon | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy">
          {%- endif -%}
        </span>
        <span class="tl-txt">{{ block.settings.label }}</span>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Liste à icônes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre (facultatif)" },

    { "type": "header", "content": "Texte" },
    { "type": "font_picker", "id": "font", "label": "Police", "default": "assistant_n4" },
    { "type": "select", "id": "font_weight", "label": "Graisse", "default": "600",
      "options": [
        { "value": "400", "label": "Normale" },
        { "value": "500", "label": "Moyenne" },
        { "value": "600", "label": "Semi-grasse" },
        { "value": "700", "label": "Grasse" }
      ] },
    { "type": "range", "id": "font_size", "label": "Taille du texte", "min": 11, "max": 28, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "font_size_mobile", "label": "Taille du texte (mobile)", "min": 11, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "line_height", "label": "Interligne", "min": 1.1, "max": 2, "step": 0.1, "default": 1.4 },
    { "type": "range", "id": "title_size", "label": "Taille du titre", "min": 14, "max": 40, "step": 1, "unit": "px", "default": 20 },
    { "type": "color", "id": "text_color", "label": "Couleur du texte", "default": "#1A1A1A" },

    { "type": "header", "content": "Icônes" },
    { "type": "range", "id": "icon_size", "label": "Taille de l'icône", "min": 16, "max": 64, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "icon_size_mobile", "label": "Taille de l'icône (mobile)", "min": 16, "max": 56, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "icon_inner", "label": "Remplissage de l'icône", "min": 40, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "icon_radius", "label": "Arrondi du fond", "min": 0, "max": 50, "step": 5, "unit": "%", "default": 50 },
    { "type": "checkbox", "id": "icon_bg_transparent", "label": "Fond des icônes transparent", "default": true },
    { "type": "color", "id": "icon_bg", "label": "Fond des icônes", "default": "#F2EDE6" },
    { "type": "range", "id": "icon_gap", "label": "Espace icône / texte", "min": 4, "max": 32, "step": 1, "unit": "px", "default": 12 },

    { "type": "header", "content": "Mise en page" },
    { "type": "select", "id": "align", "label": "Alignement", "default": "left",
      "options": [
        { "value": "left", "label": "À gauche" },
        { "value": "center", "label": "Centré" }
      ] },
    { "type": "range", "id": "gap", "label": "Espace entre les lignes", "min": 4, "max": 40, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "max_width", "label": "Largeur maximale", "min": 240, "max": 900, "step": 10, "unit": "px", "default": 420 },

    { "type": "header", "content": "Section" },
    { "type": "checkbox", "id": "bg_transparent", "label": "Fond transparent", "default": true },
    { "type": "color", "id": "bg", "label": "Couleur de fond", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_top_mobile", "label": "Marge haute (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Marge basse (mobile)", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 12 }
  ],
  "blocks": [
    {
      "type": "ligne",
      "name": "Ligne",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icône (PNG, JPG, WebP)" },
        { "type": "text", "id": "icon_url", "label": "URL de l'icône SVG", "info": "Prioritaire sur l'image ci-dessus. Importez votre SVG dans Contenu → Fichiers, puis collez son lien ici." },
        { "type": "text", "id": "label", "label": "Texte", "default": "Votre argument ici" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Liste à icônes",
      "blocks": [
        { "type": "ligne", "settings": { "label": "Enlève l'odeur, ne la masque pas" } },
        { "type": "ligne", "settings": { "label": "Zéro parfum ajouté" } },
        { "type": "ligne", "settings": { "label": "1 savon = 5 semaines" } }
      ]
    }
  ]
}
{% endschema %}